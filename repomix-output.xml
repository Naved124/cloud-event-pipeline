<file path="terraform/main.tf">
terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "ap-south-1" 
}

variable "my_ip" {
  description = "Your public IP in CIDR format, for SSH access"
  type        = string
}

data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"] # Canonical
  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }
}

resource "aws_security_group" "web_sg" {
  name        = "event-pipeline-sg"
  description = "Allow SSH and HTTP"

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.my_ip]
  }

  ingress {
    from_port   = 8080
    to_port     = 8080
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_key_pair" "deployer" {
  key_name   = "cloud-event-key"
  public_key = file("~/.ssh/cloud_event_key.pub")
}

resource "aws_iam_role" "ssm_role" {
  name = "cloud-event-ssm-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action    = "sts:AssumeRole"
      Effect    = "Allow"
      Principal = { Service = "ec2.amazonaws.com" }
    }]
  })
  
}
resource "aws_iam_role_policy" "ssm_parameter_read" {
  name = "cloud-event-pipeline-ssm-param-read"
  role = aws_iam_role.ssm_role.name

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["ssm:GetParameter", "ssm:GetParameters"]
      Resource = "arn:aws:ssm:ap-south-1:*:parameter/cloud-event-pipeline/*"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "ssm_policy" {
  role       = aws_iam_role.ssm_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

resource "aws_iam_instance_profile" "ssm_profile" {
  name = "cloud-event-ssm-profile"
  role = aws_iam_role.ssm_role.name
}

resource "aws_instance" "web_server" {
  ami                    = data.aws_ami.ubuntu.id
  instance_type          = "t3.micro"
  key_name               = aws_key_pair.deployer.key_name
  vpc_security_group_ids = [aws_security_group.web_sg.id]
  iam_instance_profile   = aws_iam_instance_profile.ssm_profile.name

  user_data = <<-EOF
              #!/bin/bash
              apt-get update -y
              apt-get install -y docker.io docker-compose-v2 git
              systemctl start docker
              systemctl enable docker
              usermod -aG docker ubuntu
              EOF

  tags = {
    Name = "CloudEventPipelineServer"
  }
}

output "instance_public_ip" {
  value = aws_instance.web_server.public_ip
}

output "instance_id" {
  value = aws_instance.web_server.id
}
</file>

<file path=".github/workflows/deploy.yml">
name: Deploy Pipeline to AWS

on:
  push:
    branches:
      - main

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: ap-south-1

      - name: Resolve current instance and wait for SSM readiness
        run: |
          INSTANCE_ID=$(aws ec2 describe-instances \
            --filters "Name=tag:Name,Values=CloudEventPipelineServer" "Name=instance-state-name,Values=running" \
            --query "Reservations[0].Instances[0].InstanceId" \
            --output text)
          echo "Resolved instance: $INSTANCE_ID"
          echo "INSTANCE_ID=$INSTANCE_ID" >> "$GITHUB_ENV"

          for i in $(seq 1 20); do
            STATUS=$(aws ssm describe-instance-information \
              --filters "Key=InstanceIds,Values=$INSTANCE_ID" \
              --query "InstanceInformationList[0].PingStatus" \
              --output text 2>/dev/null)
            if [ "$STATUS" == "Online" ]; then
              echo "Instance is online in SSM."
              exit 0
            fi
            echo "Not ready yet ($STATUS), waiting 15s... (attempt $i/20)"
            sleep 15
          done
          echo "Instance never registered with SSM after 5 minutes."
          exit 1

      - name: Deploy via AWS SSM
        run: |
          cat > params.json << 'EOF'
          {
            "commands": [
              "which git || (apt-get update -y && apt-get install -y git)",
              "if [ -d /home/ubuntu/cloud-event-pipeline ]; then cd /home/ubuntu/cloud-event-pipeline && git pull; else git clone https://github.com/Naved124/cloud-event-pipeline.git /home/ubuntu/cloud-event-pipeline; fi",
              "cd /home/ubuntu/cloud-event-pipeline && DB_USER=$(aws ssm get-parameter --name /cloud-event-pipeline/DB_USER --query Parameter.Value --output text --region ap-south-1) && echo DB_USER=$DB_USER > .env",
              "cd /home/ubuntu/cloud-event-pipeline && DB_PASSWORD=$(aws ssm get-parameter --name /cloud-event-pipeline/DB_PASSWORD --with-decryption --query Parameter.Value --output text --region ap-south-1) && echo DB_PASSWORD=$DB_PASSWORD >> .env",
              "cd /home/ubuntu/cloud-event-pipeline && DB_NAME=$(aws ssm get-parameter --name /cloud-event-pipeline/DB_NAME --with-decryption --query Parameter.Value --output text --region ap-south-1) && echo DB_NAME=$DB_NAME >> .env",
              "cd /home/ubuntu/cloud-event-pipeline && API_KEY=$(aws ssm get-parameter --name /cloud-event-pipeline/API_KEY --with-decryption --query Parameter.Value --output text --region ap-south-1) && echo API_KEY=$API_KEY >> .env",
              "docker compose -f /home/ubuntu/cloud-event-pipeline/docker-compose.yml down",
              "docker compose -f /home/ubuntu/cloud-event-pipeline/docker-compose.yml up -d --build"
            ]
          }
          EOF

          COMMAND_ID=$(aws ssm send-command \
            --instance-ids "$INSTANCE_ID" \
            --document-name "AWS-RunShellScript" \
            --parameters file://params.json \
            --query "Command.CommandId" \
            --output text)
          echo "Dispatched command: $COMMAND_ID"
          echo "COMMAND_ID=$COMMAND_ID" >> "$GITHUB_ENV"

          aws ssm wait command-executed \
            --command-id "$COMMAND_ID" \
            --instance-id "$INSTANCE_ID"

      - name: Print deploy command output
        if: always()
        run: |
          aws ssm get-command-invocation \
            --command-id "$COMMAND_ID" \
            --instance-id "$INSTANCE_ID" \
            --output text

      - name: Verify the app is actually healthy
        run: |
          INSTANCE_IP=$(aws ec2 describe-instances \
            --filters "Name=tag:Name,Values=CloudEventPipelineServer" "Name=instance-state-name,Values=running" \
            --query "Reservations[0].Instances[0].PublicIpAddress" \
            --output text)
          echo "Checking health at $INSTANCE_IP..."
          for i in $(seq 1 10); do
            if curl -sf "http://$INSTANCE_IP:8080/health"; then
              echo "Health check passed."
              exit 0
            fi
            echo "Not ready yet, retrying in 10s... (attempt $i/10)"
            sleep 10
          done
          echo "Health check failed after all retries."
          exit 1
</file>

